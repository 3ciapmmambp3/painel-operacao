{
  "version": 2,
  "builds": [
    {
      "src": "src/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/osm-tiles/(?<z>[^/]+)/(?<x>[^/]+)/(?<y>[^/]+)\\.png",
      "dest": "https://tile.openstreetmap.org/$z/$x/$y.png"
    },
    {
      "src": "/(.*)",
      "dest": "/src/$1"
    }
  ]
}
